[Unit]
Description=AbessVPN Cyber Server Panel & Master Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/abessvpn-server
ExecStart=/usr/bin/npx tsx /opt/abessvpn-server/server.ts
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
